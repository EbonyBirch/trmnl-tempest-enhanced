{%- assign te_footer_classes = '' -%}
{%- assign te_footer_policy = trmnl.plugin_settings.custom_fields_values.footer_visibility_og | default: 'show' -%}
{%- if te_footer_policy == 'hide_all' or te_footer_policy == 'hide_half_horizontal' or te_footer_policy == 'hide_partial' -%}
{%- assign te_footer_classes = te_footer_classes | append: ' te-footer-hide-og' -%}
{%- endif -%}
{%- assign te_footer_policy = trmnl.plugin_settings.custom_fields_values.footer_visibility_x | default: 'show' -%}
{%- if te_footer_policy == 'hide_all' or te_footer_policy == 'hide_half_horizontal' or te_footer_policy == 'hide_partial' -%}
{%- assign te_footer_classes = te_footer_classes | append: ' te-footer-hide-x' -%}
{%- endif -%}

{%- assign hide_footer = false -%}
{%- if te_device_family == 'og' and te_footer_classes contains 'te-footer-hide-og' -%}
  {%- assign hide_footer = true -%}
{%- elsif te_device_family == 'x' and te_footer_classes contains 'te-footer-hide-x' -%}
  {%- assign hide_footer = true -%}
{%- endif -%}

<style>
/* Scoped geometry supplements native responsive utilities. */
.te-partial .te-forecast-row { grid-row:5; }
.layout.te-partial:where(.te-horizontal) { display:grid;width:100%;min-width:0;align-items:stretch;align-content:stretch;justify-content:stretch;grid-template-columns:minmax(0,1fr);grid-template-rows:1.3fr auto auto auto 1.2fr;gap:8px; }
.te-partial:where(.te-horizontal) * { box-sizing:border-box;min-width:0; }
.te-partial:where(.te-horizontal) .te-current { display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;column-gap:14px; }
.te-partial:where(.te-horizontal) .te-weather { width:100px;height:100px;object-fit:contain;grid-row:1 / 3;filter:brightness(.5) grayscale(1); }
.te-partial:where(.te-horizontal) .te-temp { white-space:nowrap;align-self:end; }
.te-partial:where(.te-horizontal) .te-condition { align-self:start;overflow-wrap:anywhere; }
.te-partial:where(.te-horizontal) .te-metrics { gap:8px 12px;align-content:center; }
.te-partial:where(.te-horizontal) .te-metric {gap:5px; }
.te-partial:where(.te-horizontal) .te-primary-metric { flex-direction:column-reverse;align-items:flex-start;gap:3px; }
.te-partial:where(.te-horizontal) .te-icon { width:22px;height:22px;object-fit:contain;flex-shrink:0; }
.te-partial:where(.te-horizontal) .te-number { white-space:nowrap; }
.te-partial:where(.te-horizontal) .te-sun { gap:12px; }
.te-partial:where(.te-horizontal) .te-extra { display:flex;align-items:center;gap:5px; }
.te-partial:where(.te-horizontal) .te-forecast { display:grid;grid-template-rows:1fr 1fr;border-top:1px solid;min-width:0; }
.te-partial:where(.te-horizontal) .te-day { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:6px 10px;padding:10px 0;align-content:center; }


.te-partial:where(.te-horizontal) .te-day-condition { grid-column:1 / -1;overflow-wrap:anywhere; }
.te-partial:where(.te-horizontal) .te-day-detail { grid-column:1 / -1;display:grid;gap:6px;align-items:start; }
.te-partial:where(.te-horizontal) .te-precip { display:flex;flex-direction:column;gap:3px; }
.layout.te-horizontal { grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:1.4fr 1fr auto auto;gap:8px 20px; }
.te-horizontal .te-current { grid-column:1;grid-row:1; }
.te-horizontal .te-metrics { grid-column:1;grid-row:2; }
.te-horizontal .te-sun { grid-column:1;grid-row:3; }
.te-horizontal .te-extra { grid-column:1;grid-row:4; }
.te-horizontal .te-forecast { grid-column:2;grid-row:1 / 5;border-top:0;border-left:1px solid;padding-left:18px; }
.te-horizontal .te-primary-metric { flex-direction:row;align-items:baseline; }
.te-title .title { flex-shrink:0; }
.te-title .instance { min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.te-partial:where(.te-horizontal) .te-amount { text-align:left; }
.te-partial:where(.te-horizontal) .te-day-detail { grid-template-columns:.65fr 1fr; }
.te-partial:where(.te-horizontal) .te-forecast-icon { object-fit:contain;filter:brightness(.5) grayscale(1); }
.te-horizontal .te-day { position:relative;grid-template-columns:minmax(0,1fr) minmax(110px,.6fr); }
.te-horizontal .te-day-condition { grid-column:1;grid-row:2; }
.te-horizontal .te-day-detail { grid-column:1;grid-row:3; }
.te-horizontal .te-forecast-icon { grid-column:2;grid-row:2 / 4;justify-self:end;align-self:center;width:90px;height:90px; }
.te-horizontal .te-primary-metric { gap:12px; }
.te-horizontal .te-primary-metric > strong { margin-left:4px; }
.te-horizontal .te-weather { width:115px;height:115px; }
.te-horizontal .te-metrics { align-content:end; }
.screen--md .layout.te-horizontal { grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,2fr);grid-template-rows:minmax(0,1fr) auto auto auto;gap:5px 10px; }
.screen--md .te-horizontal .te-current { grid-column:1 / 3;grid-row:1; }
.screen--md .te-horizontal .te-weather { width:90px;height:90px; }
.screen--md .te-horizontal .te-metrics { display:contents; }
.screen--md .te-horizontal .te-primary-metric { grid-column:2;grid-row:1;justify-self:end;flex-direction:column-reverse;align-items:flex-start;gap:1px;width:110px; }
.screen--md .te-horizontal .te-primary-metric > strong { margin:0; }
.screen--md .te-horizontal .te-metric:nth-child(3) { grid-column:1;grid-row:2; }
.screen--md .te-horizontal .te-metric:nth-child(4) { grid-column:2;grid-row:2; }
.screen--md .te-horizontal .te-sun { grid-column:1 / 3;grid-row:3; }
.screen--md .te-horizontal .te-extra { grid-column:1 / 3;grid-row:4; }
.screen--md .te-horizontal .te-icon { width:18px;height:18px; }
.screen--md .te-horizontal .te-forecast { grid-column:3;grid-row:1 / 5;padding-left:10px;min-height:0; }
.screen--md .te-horizontal .te-day { align-content:center;min-height:0; }
.screen--md .te-horizontal .te-day-detail { display:flex;flex-wrap:wrap;gap:5px 10px; }
.screen--md .te-horizontal .te-precip { flex-direction:row;flex-wrap:wrap;align-items:baseline;gap:4px; }
.screen--md .te-horizontal .te-primary-metric { align-self:center;margin:0; }
.screen--md .te-horizontal .te-primary-metric:nth-child(2) { margin-top:0; }
.screen--md .te-horizontal .te-day { gap:2px 6px;padding:3px 0; }
.screen--md .te-horizontal .te-day-detail { grid-column:1 / -1; }
.screen--md .te-horizontal .te-current { position:relative;min-height:100px; }
.screen--md .te-horizontal .te-current > .te-weather { position:absolute;top:50%;left:0;transform:translateY(-50%); }
.screen--md .te-horizontal .te-temp { grid-column:2;grid-row:1; }
.screen--md .te-horizontal .te-condition { grid-column:2;grid-row:2; }
.screen--md .te-horizontal .te-primary-metric:nth-child(1) { transform:translateY(-25px); }
.screen--md .te-horizontal .te-primary-metric:nth-child(2) { transform:translateY(25px); }
.screen--md .te-horizontal .te-day { position:relative; }
.screen--md .te-horizontal .te-forecast-icon { position:absolute;right:0;grid-column:auto;grid-row:auto;width:48px;height:48px; }
.screen--md .te-horizontal .te-day-detail { padding-right:54px; }
.screen--md .te-horizontal .te-forecast-icon { top:auto;bottom:3px;transform:none; }
.screen--md .te-horizontal .te-day { grid-template-columns:minmax(0,1fr) max-content; }
.te-partial .te-extra-both { display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 10px; }
.te-partial .te-extra-reading { display:inline-flex;align-items:center;gap:4px;white-space:nowrap; }
.screen--md .te-horizontal .te-extra-both { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:12px;align-items:center; }
.screen--md .te-horizontal .te-extra-both .te-solar-reading { grid-column:1;grid-row:1; }
.screen--md .te-horizontal .te-extra-both .te-lightning-reading { grid-column:2;grid-row:1; }
.screen--lg.screen--portrait .te-horizontal .te-temp { align-self:center; }
.screen--lg.screen--portrait .te-horizontal .te-condition { white-space:normal; }
.te-supplementary { display:contents; }
.screen--lg.screen--portrait .layout.te-horizontal { grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:minmax(0,1fr) minmax(0,1fr);gap:14px 20px; }
.screen--lg.screen--portrait .te-horizontal .te-current { grid-column:1;grid-row:1;align-content:center;column-gap:8px; }
.screen--lg.screen--portrait .te-horizontal .te-current > .te-weather { grid-column:1;grid-row:1; }
.screen--lg.screen--portrait .te-horizontal .te-temp, .screen--lg.screen--portrait .te-horizontal .te-temp.te-temp-wide { grid-column:2;grid-row:1; }
.screen--lg.screen--portrait .te-horizontal .te-condition { grid-column:1 / -1;grid-row:2; }
.screen--lg.screen--portrait .te-horizontal .te-supplementary { display:flex;justify-content:center;gap:12px;grid-column:2;grid-row:1;border-left:1px solid;padding-left:0;min-width:0; }
.screen--lg.screen--portrait .te-horizontal .te-metrics { align-content:center; }
.screen--lg.screen--portrait .te-horizontal .te-extra-both { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:12px;align-items:center; }
.screen--lg.screen--portrait .te-horizontal .te-forecast { display:contents; }
.screen--lg.screen--portrait .te-horizontal .te-forecast > .te-day { grid-row:2;border-top:1px solid #aaa;min-height:0; }
.screen--lg.screen--portrait .te-horizontal .te-forecast > .te-day:first-child { grid-column:1; }
.screen--lg.screen--portrait .te-horizontal .te-forecast > .te-day:last-child { grid-column:2;padding-left:0; }
.screen--lg.screen--portrait .te-horizontal.te-cross { position:relative; }
.screen--lg.screen--portrait .te-horizontal.te-cross::before,
.screen--lg.screen--portrait .te-horizontal.te-cross::after { content:"";position:absolute;pointer-events:none;background:#aaa; }
.screen--lg.screen--portrait .te-horizontal.te-cross::before { top:10px;bottom:10px;left:50%;width:1px; }
.screen--lg.screen--portrait .te-horizontal.te-cross::after { left:10px;right:10px;top:50%;height:1px; }
.screen--lg.screen--portrait .te-horizontal .te-supplementary,
.screen--lg.screen--portrait .te-horizontal .te-forecast > .te-day { border:0; }
.screen--lg.screen--portrait .te-horizontal .te-forecast > .te-day:last-child { border-left:0; }
.screen--lg.screen--portrait .te-horizontal .te-current { grid-template-columns:156px minmax(0,1fr); }
.screen--lg.screen--portrait .te-horizontal .te-current > .te-weather { width:156px;height:156px; }
.screen--md .te-horizontal .te-current > .te-weather { width:111.78px;height:111.78px; }
.screen--lg:not(.screen--portrait) .te-horizontal .te-current > .te-weather { width:121.44px;height:121.44px; }
.screen--lg:not(.screen--portrait) .te-horizontal .te-extra-both { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:12px;justify-content:normal; }
.screen--lg:not(.screen--portrait) .te-horizontal .te-extra-both .te-solar-reading { grid-column:1;grid-row:1;justify-self:start; }
.screen--lg:not(.screen--portrait) .te-horizontal .te-extra-both .te-lightning-reading { grid-column:2;grid-row:1;justify-self:start; }
.screen--lg .te-horizontal .te-condition { white-space:normal;overflow-wrap:break-word;max-width:100%; }
.screen--lg .te-horizontal .te-day-temp { white-space:nowrap; }
.screen--md .te-horizontal .te-current { grid-template-columns:112px minmax(0,1fr);width:calc(100% - 120px);column-gap:7px; }
.screen--md .te-horizontal .te-condition { white-space:normal;overflow-wrap:break-word; }
.te-partial .te-condition, .te-partial .te-day-condition,
.te-partial .te-day-detail { white-space:normal;overflow-wrap:break-word; }
.te-partial .te-day-title, .te-partial .te-day-temp { margin:0; }
.screen--lg:not(.screen--portrait) .layout.te-horizontal { grid-template-rows:auto auto auto auto;align-content:center;row-gap:12px; }
.screen--lg:not(.screen--portrait) .te-horizontal .te-current { align-content:center; }
.te-horizontal .te-day { position:relative; }
.te-horizontal .te-day-separator { position:absolute; top:0; left:0; }
.te-horizontal .te-day-separator.divider--h { width:100%; }
.te-horizontal .te-day-separator.divider--v { height:100%; }
/* Keep optional readings aligned with the pressure/sunrise and wind/sunset columns. */
.screen--lg.screen--portrait .te-horizontal .te-supplementary > .te-extra { align-self:stretch;justify-content:flex-start; }
.screen--lg.screen--portrait .te-horizontal .te-extra-both .te-solar-reading { grid-column:1;grid-row:1;justify-self:start; }
.screen--lg.screen--portrait .te-horizontal .te-extra-both .te-lightning-reading { grid-column:2;grid-row:1;justify-self:start; }
/* Reclaim the gutter beside the portrait supplementary section. */
.screen--lg.screen--portrait .te-horizontal .te-supplementary { margin-left:-6px; }
.screen--lg.screen--portrait .te-horizontal .te-count-space { display:none; }
.screen--lg:not(.screen--portrait) .te-horizontal .te-day-temp { grid-column:2;grid-row:1;justify-self:end;text-align:right; }
.screen--lg.screen--portrait .te-horizontal .te-day-temp { grid-column:2;grid-row:1;justify-self:end;text-align:right; }
</style>
{% if w.temperature == blank %}
<div class="layout layout--col te-partial te-horizontal{{ te_footer_classes }}">
 <strong>Tempest data unavailable</strong>
 <span>Select an active Tempest Weather Station in plugin settings and refresh the source plugin.</span>
</div>
{% else %}
<div class="layout te-partial te-horizontal te-cross{{ te_footer_classes }}">
 <div class="te-current">
  <img class="te-weather" src="{{ w.weather_image }}" alt="{{ i18n_conditions }}">
  <span data-temperature-chars="{{ main_temperature | append: '' | size }}" class="te-temp{% if main_temperature >= 100 or main_temperature <= -10 %} te-temp-wide{% endif %} value {% if main_temperature >= 100 or main_temperature <= -10 %}value--base lg:value--large{% elsif main_temperature >= 10 or main_temperature < 0 %}value--large lg:value--xlarge{% else %}value--large lg:value--xxlarge{% endif %}">{{ main_temperature }}°</span>
  <span class="te-condition label label--small lg:label--base lg:portrait:label--large" data-value-fit="true">{{ current_conditions }}</span>
 </div>
 <div class="te-supplementary lg:portrait:flex--col">
 <div class="te-metrics grid grid--cols-2">
  <div class="te-metric flex flex--center-y te-primary-metric label label--small lg:label--base"><span>{{ secondary_temperature_label }}</span><strong class="te-number value value--small lg:value--base">{{ secondary_temperature_value | round }}°</strong></div>
  <div class="te-metric flex flex--center-y te-primary-metric label label--small lg:label--base"><span>{{ i18n_humidity }}</span><strong class="te-number value value--small lg:value--base">{{ w.humidity }}%</strong></div>
  <div class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-barometer.svg" alt="{{ i18n_pressure }}"><span class="te-number">{{ current_pressure }} {{ pressure_units }}</span>{% if pressure_trend_icon != blank %}<img class="te-icon" src="{{ pressure_trend_icon }}" alt="{{ pressure_trend_alt }}">{% endif %}</div>
  <div class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://tempestwx.com/images/Updated/wind-arrow-{{ w.forecast.right_now.wind.direction_cardinal | downcase }}.svg" alt="{{ i18n_wind_direction }}"><span class="te-number">{{ w.forecast.right_now.wind.gust }} {{ w.forecast.right_now.wind.units }}</span></div>
 </div>
 <div class="te-sun grid grid--cols-2">
  <span class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-sunrise.svg" alt="{{ i18n_sunrise }}">{{ w.forecast.right_now.sunrise }}</span>
  <span class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-sunset.svg" alt="{{ i18n_sunset }}">{{ w.forecast.right_now.sunset }}</span>
 </div>
 {% if information_below_weather_icon == 'both' %}
 {% if solar_available or lightning_available %}
 <div class="te-extra te-extra-both label label--small lg:label--base">
 {% if solar_available %}<span class="te-extra-reading te-solar-reading"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-day-sunny.svg" alt="{{ i18n_solar_radiation }}"><span>{% if solar_radiation != blank %}{{ solar_radiation | round }}{% else %}—{% endif %} W/m² ({% if current_brightness != blank %}{{ current_brightness | round }}{% else %}—{% endif %} lux)</span></span>{% endif %}
 {% if lightning_available %}<span class="te-extra-reading te-lightning-reading"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-lightning.svg" alt="{{ i18n_lightning }}"><span>{{ lightning_last_time }} @ {{ lightning_last_distance }} {{ lightning_distance_units }} ({{ lightning_count_1h }}<span class="te-count-space"> </span>/<span class="te-count-space"> </span>{{ lightning_count_3h }})</span></span>{% endif %}
 </div>
 {% endif %}
 {% else %}
 {% if information_below_weather_icon == 'lightning' and lightning_available %}
 <div class="te-extra label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-lightning.svg" alt="{{ i18n_lightning }}"><span>{{ lightning_last_time }} @ {{ lightning_last_distance }} {{ lightning_distance_units }} ({{ lightning_count_1h }}<span class="te-count-space"> </span>/<span class="te-count-space"> </span>{{ lightning_count_3h }})</span></div>
 {% elsif information_below_weather_icon == 'solar' and solar_available %}
 <div class="te-extra label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-day-sunny.svg" alt="{{ i18n_solar_radiation }}"><span>{% if solar_radiation != blank %}{{ solar_radiation | round }}{% else %}—{% endif %} W/m² ({% if current_brightness != blank %}{{ current_brightness | round }}{% else %}—{% endif %} lux)</span></div>
 {% endif %}
 {% endif %}
 </div>
 <div class="te-forecast">
<div class="te-day">
 <strong class="te-day-title title title--small lg:title--base">{{ today_label }}</strong>
 {% capture te_forecast_min %}{{ w.forecast.today.mintemp | round }}°{% endcapture %}{% capture te_forecast_max %}{{ w.forecast.today.maxtemp | round }}°{% endcapture %}
 <span class="te-number te-day-temp{% if te_forecast_min.size > 3 or te_forecast_max.size > 3 %} te-day-temp-wide{% endif %} value value--xxsmall lg:value--small">{{ te_forecast_min }} / {{ te_forecast_max }}</span>
 <span class="te-day-condition label label--small lg:label--base">{{ today_conditions }}</span>
 {% if w.today_weather_image != blank %}<img class="te-forecast-icon" src="{{ w.today_weather_image }}" alt="{{ today_conditions }}">{% endif %}
 <div class="te-day-detail label label--small lg:label--base">
  <span class="te-number">{{ i18n_uv_short }} {{ w.forecast.today.uv_index }}</span>
<span class="te-precip"><span class="te-precip-label">{{ i18n_precipitation }}</span><span class="te-number">{{ w.forecast.today.precip.probability }}%</span>{% if w.forecast.today.precip.amount != blank %}<span class="te-number te-amount">{{ w.forecast.today.precip.amount | round: 1 }} {{ w.forecast.today.precip.units }}</span>{% endif %}</span>
 </div>
</div>
<div class="te-day">
<div class="divider--h te-day-separator lg:portrait:hidden" aria-hidden="true"></div>
 <strong class="te-day-title title title--small lg:title--base">{{ tomorrow_label }}</strong>
 {% capture te_forecast_min %}{{ w.forecast.tomorrow.mintemp | round }}°{% endcapture %}{% capture te_forecast_max %}{{ w.forecast.tomorrow.maxtemp | round }}°{% endcapture %}
 <span class="te-number te-day-temp{% if te_forecast_min.size > 3 or te_forecast_max.size > 3 %} te-day-temp-wide{% endif %} value value--xxsmall lg:value--small">{{ te_forecast_min }} / {{ te_forecast_max }}</span>
 <span class="te-day-condition label label--small lg:label--base">{{ tomorrow_conditions }}</span>
 {% if w.tomorrow_weather_image != blank %}<img class="te-forecast-icon" src="{{ w.tomorrow_weather_image }}" alt="{{ tomorrow_conditions }}">{% endif %}
 <div class="te-day-detail label label--small lg:label--base">
  <span class="te-number">{{ i18n_uv_short }} {{ w.forecast.tomorrow.uv_index }}</span>
<span class="te-precip"><span class="te-precip-label">{{ i18n_precipitation }}</span><span class="te-number">{{ w.forecast.tomorrow.precip.probability }}%</span>{% if w.forecast.tomorrow.precip.amount != blank %}<span class="te-number te-amount">{{ w.forecast.tomorrow.precip.amount | round: 1 }} {{ w.forecast.tomorrow.precip.units }}</span>{% endif %}</span>
 </div>
</div>
 </div>
</div>
{% endif %}
{% unless hide_footer %}
<div class="title_bar te-title{{ te_footer_classes }}">
 <span class="image">t°</span><span class="title">{{ i18n_weather }}</span>
 <span class="instance">{{ trmnl.plugin_settings.instance_name }}{% if footer_refreshed_at != blank %} ({{ footer_refreshed_at }}){% endif %}</span>
</div>
{% endunless %}
