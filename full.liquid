{%- assign te_footer_classes = '' -%}
{%- assign te_footer_policy = trmnl.plugin_settings.custom_fields_values.footer_visibility_og | default: 'show' -%}
{%- if te_footer_policy == 'hide_all' or te_footer_policy == 'hide_full' -%}
{%- assign te_footer_classes = te_footer_classes | append: ' te-footer-hide-og' -%}
{%- endif -%}
{%- assign te_footer_policy = trmnl.plugin_settings.custom_fields_values.footer_visibility_x | default: 'show' -%}
{%- if te_footer_policy == 'hide_all' or te_footer_policy == 'hide_full' -%}
{%- assign te_footer_classes = te_footer_classes | append: ' te-footer-hide-x' -%}
{%- endif -%}

{%- assign hide_footer = false -%}
{%- if te_device_family == 'og' and te_footer_classes contains 'te-footer-hide-og' -%}
  {%- assign hide_footer = true -%}
{%- elsif te_device_family == 'x' and te_footer_classes contains 'te-footer-hide-x' -%}
  {%- assign hide_footer = true -%}
{%- endif -%}

<style>
/* Scoped geometry supplements native responsive utilities. */
.tempest-responsive-spans .te-nowrap, .tempest-responsive-spans [data-te-nowrap] { white-space:nowrap;min-width:0; }
.tempest-responsive-spans [data-te-center] { justify-content:center; }
.tempest-responsive-spans [data-te-black] { filter:brightness(0) saturate(0%); }
.tempest-responsive-spans .wx-gray { filter: brightness(0.5) saturate(0%); }
.tempest-responsive-spans .weather-icon-cell { position: relative; }
.tempest-responsive-spans .weather-icon-info { position: absolute;left: 0;right: 0;bottom: 0;width: 100%; }
.tempest-responsive-spans .top-middle-column { margin-left: -5px;margin-right: -5px;width: calc(100% + 10px); }
.tempest-responsive-spans .pressure-trend-arrow { margin-left: auto;transform: translateX(4px); }
@media (min-width: 1200px) {
    .tempest-responsive-spans .pressure-trend-arrow {
      transform: none;
    }
  }
.screen--lg.screen--portrait .tempest-responsive-spans .te-current-grid {grid-template-rows:auto auto;align-items:center;row-gap:16px; }
.screen--lg.screen--portrait .tempest-responsive-spans .weather-icon-cell { grid-column:1 / 3 !important;grid-row:1;gap:8px; }
.screen--lg.screen--portrait .tempest-responsive-spans .weather-icon-cell > img { width:48cqw !important;height:48cqw !important;max-width:100%;object-fit:contain; }
.screen--lg.screen--portrait .tempest-responsive-spans .weather-icon-info { position:static; }
.screen--lg.screen--portrait .tempest-responsive-spans .top-middle-column { grid-column:1 / 3 !important;grid-row:2;width:100%;margin:0; }
.screen--lg.screen--portrait .tempest-responsive-spans .top-middle-column > .item { width:100%; }
.screen--lg.screen--portrait .tempest-responsive-spans .top-middle-column > .item > .content { display:grid;grid-template-columns:minmax(0,3fr) minmax(0,2fr);align-items:center;column-gap:12px;width:100%;min-width:0; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-current-temperature { grid-column:1;min-width:0; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-sun-times { grid-column:2;grid-row:1;align-self:end; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-wind-pressure { grid-column:2;grid-row:2;align-self:start;margin-top:8px !important; }
.screen--lg.screen--portrait .tempest-responsive-spans .top-middle-column .te-measurements > .grid {row-gap:8px;min-width:0; }
.screen--lg.screen--portrait .tempest-responsive-spans .top-middle-column .te-measurements > .grid > div { grid-column:1 / -1;white-space:nowrap; }
.screen--lg.screen--portrait .tempest-responsive-spans .top-middle-column .te-measurements > .grid img { height:24px !important; }
.screen--lg.screen--portrait .tempest-responsive-spans .top-middle-column .te-measurements > .grid > div > div:first-child { width:28px !important;flex-shrink:0; }
.screen--lg.screen--portrait .tempest-responsive-spans .top-middle-column .pressure-trend-arrow { margin-left:6px;transform:none; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-current-secondary { grid-column:3 !important;grid-row:1 / 3;align-self:stretch; }
.tempest-responsive-spans .te-portrait-extra { display:none; }
.screen--lg.screen--portrait .tempest-responsive-spans .weather-icon-cell { justify-content:center !important;align-items:center !important;width:100%; }
.screen--lg.screen--portrait .tempest-responsive-spans .weather-icon-cell > .weather-icon-info { display:none !important; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-extra { display:block;grid-column:2;grid-row:3;min-width:0;align-self:start; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-extra .weather-icon-info { position:static;margin-top:8px; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-extra .weather-icon-info > div { display:grid;gap:8px;align-items:center; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-extra img { height:24px !important;width:24px;justify-self:center; }
.tempest-responsive-spans .te-measurements { display:contents; }
.screen--lg.screen--portrait .tempest-responsive-spans .top-middle-column > .item > .content { grid-template-rows:auto; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-current-temperature { grid-row:1; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-measurements { display:flex;flex-direction:column;justify-content:center;gap:8px;grid-column:2;grid-row:1;min-width:0;align-self:center; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-measurements > .grid { margin:0 !important;width:100%;align-self:stretch; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-measurements .te-portrait-extra { display:contents; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-measurements .te-portrait-extra .weather-icon-info { margin:0; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-extra .weather-icon-info > div { column-gap:4px; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-measurements { margin-left:-16px;width:calc(100% + 32px);max-width:none;overflow:visible; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-extra .weather-icon-info { max-width:none;overflow:visible; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-extra .weather-icon-info > div { grid-template-columns:28px max-content;max-width:none;overflow:visible; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-extra span { white-space:nowrap !important;max-width:none; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-measurements > .grid > div,
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-extra .weather-icon-info > div { display:grid !important;grid-template-columns:28px max-content !important;column-gap:4px !important;justify-content:start !important;justify-items:start;align-items:center;width:100%;min-width:0; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-extra .weather-icon-info { align-items:stretch !important;justify-content:start !important;width:100%; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-measurements > .grid > div > div:first-child { justify-self:center;justify-content:center; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-condition { width:100%;text-align:center;white-space:normal; }
.screen--lg.screen--portrait .tempest-responsive-spans .weather-icon-cell > img,
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-condition { position:relative; }
.screen--md .tempest-responsive-spans .weather-icon-cell > img { position:relative;top:-10px;width:17.6cqw !important;height:auto !important; }
.screen--lg .tempest-responsive-spans .weather-icon-cell > img { position:relative;top:-24px; }
.screen--lg.screen--portrait .tempest-responsive-spans .weather-icon-cell > img,
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-condition { top:-40px; }
.screen--lg.screen--portrait .tempest-responsive-spans .te-portrait-marker { width:4px;min-width:4px;flex-basis:4px; }
</style>

{%- if w.temperature == blank -%}
  <div class="layout tempest-responsive-spans layout--col flex flex--center-x flex--center-y gap--medium{{ te_footer_classes }}">
    <span class="value value--small">Tempest data unavailable</span>
    <span class="label">Select an active Tempest Weather Station in plugin settings and refresh the source plugin.</span>
  </div>
  {% unless hide_footer %}
<div class="title_bar{{ te_footer_classes }}">
    <span class="image">t°</span>
    <h1 class="title">{{ i18n_weather }}</h1>
    <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
  </div>
{% endunless %}
{%- else -%}
  <div class="layout tempest-responsive-spans layout--col gap--space-between{{ te_footer_classes }}">
    <!-- Top half: native Tempest structure, not a hand-made recreation. -->
    <div class="grid te-current-grid lg:portrait:grid--cols-3">
      <div class="row row--center col--span-3 col--end weather-icon-cell lg:portrait:flex--col">
        <img src="{{ w.weather_image }}"
             class="image--adaptive w--[22cqw] h--auto lg:w--[28cqw] wx-gray"
             alt="{{ i18n_conditions }}">

        <span class="label lg:label--large te-portrait-condition hidden lg:portrait:block">{{ current_conditions }}</span>

        {% capture te_full_optional_info %}
        {% if information_below_weather_icon == 'lightning' %}
          {% if lightning_available %}
            <div class="weather-icon-info flex flex--col flex--center-x">
              <div class="flex flex--row flex--center-x flex--center-y gap--xsmall w--full label lg:label--large lg:portrait:label--base">
                <img src="https://trmnl.com/images/plugins/weather/wi-lightning.svg"
                     class="h--5 lg:h--7"
                     alt="{{ i18n_lightning }}">
                <span class="text--regular te-nowrap">{{ lightning_last_time }} @ {{ lightning_last_distance }} {{ lightning_distance_units }} ({{ lightning_count_1h }} / {{ lightning_count_3h }})</span>
              </div>
            </div>
          {% endif %}

        {% elsif information_below_weather_icon == 'solar' or information_below_weather_icon == 'both' %}
          <div class="weather-icon-info flex flex--col flex--center-x">
            {% if solar_available %}
              <div class="flex flex--row flex--center-x flex--center-y gap--xsmall w--full label lg:label--large lg:portrait:label--base">
                <img src="https://trmnl.com/images/plugins/weather/wi-day-sunny.svg"
                     class="h--5 lg:h--7"
                     alt="{{ i18n_solar_radiation }}">
                <span class="text--regular te-nowrap">{% if solar_radiation != blank %}{{ solar_radiation | round }} W/m²{% else %}— W/m²{% endif %} ({% if current_brightness != blank %}{{ current_brightness | round }} lux{% else %}— lux{% endif %})</span>
              </div>
            {% endif %}
          </div>
        {% endif %}
        {% endcapture %}
        {{ te_full_optional_info }}
      </div>

      <div class="col col--span-3 col--end top-middle-column">
        <div class="item h--full">
          <div class="meta lg:portrait:hidden"></div>
          <div class="content">
            <div class="flex flex--center-x w--full te-current-temperature">
              <span data-temperature-chars="{{ main_temperature_chars }}" class="value {{ main_temperature_class }} {{ main_temperature_lg_class }} w--full text--center">{{ main_temperature }}°</span>
            </div>
            <div class="te-measurements">
            <div class="grid grid--cols-12 lg:portrait:grid--cols-1 w--full te-sun-times">
              <div class="col--span-5 flex flex--row flex--left flex--center-y gap--xsmall label lg:label--large lg:portrait:label--base">
                <div class="w--8 lg:w--10 flex flex--center-x flex--center-y">
                  <img src="https://trmnl.com/images/plugins/weather/wi-sunrise.svg" class="h--6 lg:h--8" alt="{{ i18n_sunrise }}">
                </div>
                <span>{{ w.forecast.right_now.sunrise }}</span>
              </div>
              <div class="col--span-7 flex flex--row flex--left flex--center-y gap--none lg:gap--xsmall label lg:label--large lg:portrait:label--base">
                <div class="w--8 lg:w--10 flex flex--center-x flex--center-y">
                  <img src="https://trmnl.com/images/plugins/weather/wi-sunset.svg" class="h--6 lg:h--8" alt="{{ i18n_sunset }}">
                </div>
                <span>{{ w.forecast.right_now.sunset }}</span>
              </div>
            </div>
            <div class="grid grid--cols-12 lg:portrait:grid--cols-1 w--full te-wind-pressure">
              <div class="col--span-5 flex flex--row flex--left flex--center-y gap--xsmall label lg:label--large lg:portrait:label--base">
                <div class="w--8 lg:w--10 flex flex--center-x flex--center-y">
                  <img src="https://tempestwx.com/images/Updated/wind-arrow-{{ w.forecast.right_now.wind.direction_cardinal | downcase }}.svg" class="h--6 lg:h--8" data-te-black="true" alt="{{ i18n_wind_direction }}">
                </div>
                <span><span class="te-nowrap">{{ w.forecast.right_now.wind.gust }} {{ w.forecast.right_now.wind.units }}</span></span>
              </div>
              <div class="col--span-7 flex flex--row flex--left flex--center-y gap--none lg:gap--xsmall label lg:label--large lg:portrait:label--base">
                {% if current_pressure != blank %}
                  <div class="w--8 lg:w--10 flex flex--center-x flex--center-y">
                    <img src="https://trmnl.com/images/plugins/weather/wi-barometer.svg" class="h--6 lg:h--8" alt="{{ i18n_pressure }}">
                  </div>
                  <div class="flex flex--row flex--left flex--center-y gap--none grow" data-te-nowrap="true">
                    <span>{{ current_pressure }} {{ pressure_units }}</span>
                    {% if pressure_trend_icon != blank %}
                      <img src="{{ pressure_trend_icon }}" class="h--6 lg:h--7 pressure-trend-arrow" alt="{{ pressure_trend_alt }}">
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
            <div class="te-portrait-extra">{{ te_full_optional_info }}
              {% if information_below_weather_icon == 'both' and lightning_available %}
              <div class="weather-icon-info flex flex--col flex--center-x">
                <div class="flex flex--row flex--center-x flex--center-y gap--xsmall w--full label lg:label--large lg:portrait:label--base">
                  <img src="https://trmnl.com/images/plugins/weather/wi-lightning.svg" class="h--5 lg:h--7" alt="{{ i18n_lightning }}">
                  <span class="text--regular">{{ lightning_last_time }} @ {{ lightning_last_distance }} {{ lightning_distance_units }} ({{ lightning_count_1h }} / {{ lightning_count_3h }})</span>
                </div>
              </div>
              {% endif %}
            </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col col--span-3 col--end gap--medium h--full te-current-secondary">
        <div class="item lg:grow lg:basis--0">
          <div class="meta te-portrait-marker"></div>
          <div class="icon self--center">
            <img src="https://trmnl.com/images/plugins/weather/wi-thermometer.svg" class="image--adaptive w--[6cqw] lg:w--[8cqw] " alt="{{ i18n_temperature }}">
          </div>
          <div class="content self--center">
            <span class="value value--small lg:value--large">{{ secondary_temperature_value | round }}°</span>
            <span class="label lg:label--large">{{ secondary_temperature_label }}</span>
          </div>
        </div>

        <div class="item lg:grow lg:basis--0">
          <div class="meta te-portrait-marker"></div>
          <div class="icon self--center">
            <img src="https://trmnl.com/images/plugins/weather/wi-raindrops.svg" class="image--adaptive w--[6cqw] lg:w--[8cqw] " alt="{{ i18n_humidity }}">
          </div>
          <div class="content self--center">
            <span class="value value--small lg:value--large">{{ w.humidity }}%</span>
            <span class="label lg:label--large">{{ i18n_humidity }}</span>
          </div>
        </div>

        <div class="item lg:grow lg:basis--0">
          <div class="meta te-portrait-marker"></div>
          <div class="icon self--center">
            <img src="{{ w.weather_image }}" class="image--adaptive w--[6cqw] lg:w--[8cqw] wx-gray" alt="{{ i18n_conditions }}">
          </div>
          <div class="content self--center">
            <span class="value value--xsmall lg:value--base" data-value-fit="true" data-value-fit-max-height="96">{{ current_conditions }}</span>
            <span class="label lg:label--large">{{ i18n_right_now }}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    <!-- Forecast: native item structure/typography. Column spans use 4/2/2/4 instead of the native 3/3/3/3 split on both OG and X. Visible labels use TRMNL custom-plugin i18n via l_word. Main temperature scales responsively on lg. -->
    <div class="grid">
      <div class="col gap--large">
        <div class="grid grid--cols-12">
          <div class="item col--span-4 lg:col--span-4 grow">
            <div class="meta te-portrait-marker"></div>
            <div class="icon self--center">
              <img src="{{ w.today_weather_image }}" class="image--adaptive w--[6cqw] wx-gray" alt="{{ i18n_today }} — {{ i18n_conditions }}">
            </div>
            <div class="content self--center">
              <span class="value value--small lg:value--base" data-value-fit="true" data-value-fit-max-height="96">{{ today_conditions }}</span>
              <span class="label lg:label--large">{{ today_label }}</span>
            </div>
          </div>

          <div class="item col--span-2 lg:col--span-2 grow">
            <div class="meta te-portrait-marker"></div>
            <div class="icon self--center">
              <img src="https://trmnl.com/images/plugins/weather/wi-hot.svg" class="image--adaptive w--[6cqw] " alt="{{ i18n_uv }}">
            </div>
            <div class="content self--center">
              <span class="value value--small lg:value--base">{{ w.forecast.today.uv_index }}</span>
              <span class="label label--large lg:label--xlarge">{{ i18n_uv_short }}</span>
            </div>
          </div>

          <div class="item col--span-2 lg:col--span-2 grow">
            <div class="meta te-portrait-marker"></div>
            <div class="icon self--center">
              <img src="https://tempestwx.com/images/Updated/{{ w.forecast.today.precip.icon }}.svg" class="image--adaptive w--[4cqw] lg:w--[6cqw] wx-gray" alt="{{ i18n_precipitation }}">
            </div>
            <div class="content self--center">
              <span class="value value--small lg:value--base" data-value-fit="true">{{ w.forecast.today.precip.probability }}%</span>
              {% if w.forecast.today.precip.amount != blank %}
                <span class="label lg:label--large w--full text--left">{{ w.forecast.today.precip.amount | round: 1 }} {{ w.forecast.today.precip.units }}</span>
              {% endif %}
            </div>
          </div>

          <div class="row col--span-4 lg:col--span-4 grow">
            <div class="item">
              <div class="meta te-portrait-marker"></div>
              <div class="icon self--center">
                <img src="https://trmnl.com/images/plugins/weather/wi-thermometer.svg" class="image--adaptive w--[6cqw] " alt="{{ i18n_temperature }}">
              </div>
              <div class="grid grid--cols-2 grow self--center gap--medium">
                <div class="content">
                  <span class="value value--small lg:value--large" data-value-fit="true">{{ w.forecast.today.mintemp | round }}°</span>
                  <span class="label label--large lg:label--xlarge">{{ i18n_min }}</span>
                </div>
                <div class="content">
                  <span class="value value--small lg:value--large" data-value-fit="true">{{ w.forecast.today.maxtemp | round }}°</span>
                  <span class="label label--large lg:label--xlarge">{{ i18n_max }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid--cols-12">
          <div class="item col--span-4 lg:col--span-4 grow">
            <div class="meta te-portrait-marker"></div>
            <div class="icon self--center">
              <img src="{{ w.tomorrow_weather_image }}" class="image--adaptive w--[6cqw] wx-gray" alt="{{ i18n_tomorrow }} — {{ i18n_conditions }}">
            </div>
            <div class="content self--center">
              <span class="value value--small lg:value--base" data-value-fit="true" data-value-fit-max-height="96">{{ tomorrow_conditions }}</span>
              <span class="label lg:label--large">{{ tomorrow_label }}</span>
            </div>
          </div>

          <div class="item col--span-2 lg:col--span-2 grow">
            <div class="meta te-portrait-marker"></div>
            <div class="icon self--center">
              <img src="https://trmnl.com/images/plugins/weather/wi-hot.svg" class="image--adaptive w--[6cqw] " alt="{{ i18n_uv }}">
            </div>
            <div class="content self--center">
              <span class="value value--small lg:value--base">{{ w.forecast.tomorrow.uv_index }}</span>
              <span class="label label--large lg:label--xlarge">{{ i18n_uv_short }}</span>
            </div>
          </div>

          <div class="item col--span-2 lg:col--span-2 grow">
            <div class="meta te-portrait-marker"></div>
            <div class="icon self--center">
              <img src="https://tempestwx.com/images/Updated/{{ w.forecast.tomorrow.precip.icon }}.svg" class="image--adaptive w--[4cqw] lg:w--[6cqw] wx-gray" alt="{{ i18n_precipitation }}">
            </div>
            <div class="content self--center" data-te-center="true">
              <span class="value value--small lg:value--base" data-value-fit="true">{{ w.forecast.tomorrow.precip.probability }}%</span>
            </div>
          </div>

          <div class="row col--span-4 lg:col--span-4 grow">
            <div class="item">
              <div class="meta te-portrait-marker"></div>
              <div class="icon self--center">
                <img src="https://trmnl.com/images/plugins/weather/wi-thermometer.svg" class="image--adaptive w--[6cqw] " alt="{{ i18n_temperature }}">
              </div>
              <div class="grid grid--cols-2 grow self--center gap--medium">
                <div class="content">
                  <span class="value value--small lg:value--large" data-value-fit="true">{{ w.forecast.tomorrow.mintemp | round }}°</span>
                  <span class="label label--large lg:label--xlarge">{{ i18n_min }}</span>
                </div>
                <div class="content">
                  <span class="value value--small lg:value--large" data-value-fit="true">{{ w.forecast.tomorrow.maxtemp | round }}°</span>
                  <span class="label label--large lg:label--xlarge">{{ i18n_max }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% unless hide_footer %}
<div class="title_bar{{ te_footer_classes }}">
    <span class="image">t°</span>
    <h1 class="title">{{ i18n_weather }}</h1>
    <span class="instance">{{ trmnl.plugin_settings.instance_name }}{% if footer_refreshed_at != blank %} ({{ footer_refreshed_at }}){% endif %}</span>
  </div>
{% endunless %}
{%- endif -%}
