{%- assign te_footer_classes = '' -%}
{%- assign te_footer_policy = trmnl.plugin_settings.custom_fields_values.footer_visibility_og | default: 'show' -%}
{%- if te_footer_policy == 'hide_all' or te_footer_policy == 'hide_quadrant' or te_footer_policy == 'hide_partial' -%}
{%- assign te_footer_classes = te_footer_classes | append: ' te-footer-hide-og' -%}
{%- endif -%}
{%- assign te_footer_policy = trmnl.plugin_settings.custom_fields_values.footer_visibility_x | default: 'show' -%}
{%- if te_footer_policy == 'hide_all' or te_footer_policy == 'hide_quadrant' or te_footer_policy == 'hide_partial' -%}
{%- assign te_footer_classes = te_footer_classes | append: ' te-footer-hide-x' -%}
{%- endif -%}

{%- assign hide_footer = false -%}
{%- if te_device_family == 'og' and te_footer_classes contains 'te-footer-hide-og' -%}
  {%- assign hide_footer = true -%}
{%- elsif te_device_family == 'x' and te_footer_classes contains 'te-footer-hide-x' -%}
  {%- assign hide_footer = true -%}
{%- endif -%}

<style>
/* Scoped geometry supplements native responsive utilities. */
.te-partial .te-forecast-row { grid-row:5; }
.layout.te-partial:where(.te-quadrant) { display:grid;width:100%;min-width:0;align-items:stretch;align-content:stretch;justify-content:stretch;grid-template-columns:minmax(0,1fr);grid-template-rows:1.3fr auto auto auto 1.2fr;gap:8px; }
.te-partial:where(.te-quadrant) * { box-sizing:border-box;min-width:0; }
.te-partial:where(.te-quadrant) .te-current { display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;column-gap:14px; }
.te-partial:where(.te-quadrant) .te-weather { width:100px;height:100px;object-fit:contain;grid-row:1 / 3;filter:brightness(.5) grayscale(1); }
.te-partial:where(.te-quadrant) .te-temp { white-space:nowrap;align-self:end; }
.te-partial:where(.te-quadrant) .te-condition { align-self:start;overflow-wrap:anywhere; }
.te-partial:where(.te-quadrant) .te-metrics { gap:8px 12px;align-content:center; }
.te-partial:where(.te-quadrant) .te-metric {gap:5px; }
.te-partial:where(.te-quadrant) .te-primary-metric { flex-direction:column-reverse;align-items:flex-start;gap:3px; }
.te-partial:where(.te-quadrant) .te-icon { width:22px;height:22px;object-fit:contain;flex-shrink:0; }
.te-partial:where(.te-quadrant) .te-number { white-space:nowrap; }
.te-partial:where(.te-quadrant) .te-sun { gap:12px; }
.te-partial:where(.te-quadrant) .te-extra { display:flex;align-items:center;gap:5px; }
.te-partial:where(.te-quadrant) .te-forecast { display:grid;grid-template-rows:1fr 1fr;border-top:1px solid;min-width:0; }
.te-partial:where(.te-quadrant) .te-day { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:6px 10px;padding:10px 0;align-content:center; }


.te-partial:where(.te-quadrant) .te-day-condition { grid-column:1 / -1;overflow-wrap:anywhere; }
.te-partial:where(.te-quadrant) .te-day-detail { grid-column:1 / -1;display:grid;gap:6px;align-items:start; }
.te-partial:where(.te-quadrant) .te-precip { display:flex;flex-direction:column;gap:3px; }
.te-quadrant .te-weather { width:192.0px;height:192.0px; }
.te-quadrant .te-primary-metric { flex-direction:row;align-items:baseline; }
.te-quadrant .te-icon { width:16px;height:16px; }
.te-quadrant .te-metrics { gap:4px 10px; }
.te-quadrant .te-day { padding:5px 0;gap:3px 8px; }

.te-quadrant .te-precip { flex-direction:row;align-items:baseline; }
.te-title .title { flex-shrink:0; }
.te-title .instance { min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.te-partial:where(.te-quadrant) .te-amount { text-align:left; }
.te-partial:where(.te-quadrant) .te-day-detail { grid-template-columns:.65fr 1fr; }
.te-partial:where(.te-quadrant) .te-forecast-icon { object-fit:contain;filter:brightness(.5) grayscale(1); }
.te-quadrant .te-day-detail { grid-template-columns:.6fr 2.3fr; }
.te-quadrant .te-precip { flex-wrap:wrap;gap:5px; }
.te-quadrant .te-amount { margin-left:4px; }
.te-quadrant .te-weather { max-width:none; }
.te-quadrant .te-metrics > .te-metric:not(.te-primary-metric) .te-icon,
.te-quadrant .te-sun .te-icon { width:1.25em;height:1.25em; }
.layout.te-quadrant { grid-template-rows:minmax(124px,1fr) auto auto auto minmax(90px,1fr);gap:4px; }
.te-quadrant .te-current { position:relative;grid-template-columns:192px minmax(0,1fr);min-height:124px; }
.te-quadrant .te-current > .te-weather { position:absolute;left:0;top:50%;transform:translateY(-50%); }
.te-quadrant .te-current > .te-temp { grid-column:2;grid-row:1; }
.te-quadrant .te-current > .te-condition { grid-column:2;grid-row:2; }
.screen--md .layout.te-quadrant { grid-template-columns:1.6fr 1fr 1fr 1fr;gap:3px 5px; }
.screen--md .te-quadrant .te-current { grid-row:1; }
.screen--md .te-quadrant .te-metrics, .screen--md .te-quadrant .te-sun { display:contents; }
.screen--md .te-quadrant .te-metrics > .te-metric:nth-child(3) { grid-column:1;grid-row:3; }
.screen--md .te-quadrant .te-metrics > .te-metric:nth-child(4) { grid-column:2;grid-row:3; }
.screen--md .te-quadrant .te-sun > .te-metric:nth-child(1) { grid-column:3;grid-row:3; }
.screen--md .te-quadrant .te-sun > .te-metric:nth-child(2) { grid-column:4;grid-row:3; }
.screen--md .te-quadrant .te-extra { grid-column:1 / -1;grid-row:4; }
.screen--md .te-quadrant .te-forecast { grid-column:1 / -1;grid-row:5;grid-template-columns:1fr 1fr;grid-template-rows:auto;gap:8px; }
.screen--md .te-quadrant .te-day { padding:3px 0 0;gap:2px 4px; }
.screen--md .te-quadrant .te-day + .te-day { padding-left:8px; }
.screen--md .te-quadrant .te-day-detail { display:flex; }
.screen--md .te-quadrant .te-precip { gap:3px; }
.screen--md .te-quadrant .te-current { grid-column:1 / -1; }
.screen--md .te-quadrant .te-primary-metric { grid-row:1;align-self:center;justify-self:end;flex-direction:column-reverse;align-items:flex-start;gap:1px;margin:0; }
.screen--md .te-quadrant .te-primary-metric:nth-child(1) { grid-column:3 / 5;transform:translateY(-32px); }
.screen--md .te-quadrant .te-primary-metric:nth-child(2) { grid-column:3 / 5;transform:translateY(16px); }
.screen--md .te-quadrant .te-metrics > .te-metric:not(.te-primary-metric) .te-icon,
.screen--md .te-quadrant .te-sun .te-icon,
.screen--md .te-quadrant .te-extra .te-icon { width:1.25em;height:1.25em; }
.screen--lg .te-quadrant .te-primary-metric { column-gap:12px; }
.screen--md .te-quadrant .te-current { width:calc(100% - 96px); }
.screen--md .te-quadrant .te-primary-metric { width:88px; }
.te-partial .te-extra-both { display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 10px; }
.te-partial .te-extra-reading { display:inline-flex;align-items:center;gap:4px;white-space:nowrap; }
.screen--lg .te-quadrant .te-extra-both { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:12px; }
.screen--lg .te-quadrant .te-lightning-reading { grid-column:2; }
.screen--md .te-quadrant .te-extra-both { display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;column-gap:5px; }
.screen--md .te-quadrant .te-solar-reading { grid-column:1 / 3; }
.screen--md .te-quadrant .te-lightning-reading { grid-column:3 / 5; }
.screen--lg.screen--portrait .te-quadrant .te-weather { width:153.6px;height:153.6px; }
.screen--lg.screen--portrait .te-quadrant .te-current { grid-template-columns:153.6px minmax(0,1fr);column-gap:8px; }
.screen--lg.screen--portrait .te-quadrant .te-condition-wrap { white-space:normal !important;overflow-wrap:break-word;word-break:normal;width:100%;max-width:100%;height:auto;max-height:none;overflow:visible; }
.screen--lg.screen--portrait .te-quadrant .te-current { grid-template-rows:auto auto;min-height:min-content; }
.screen--md .te-quadrant .te-current > .te-weather { width:102.8736px;height:102.8736px; }
.screen--lg .te-quadrant .te-condition { white-space:normal;overflow-wrap:break-word;max-width:100%; }
.screen--lg .te-quadrant .te-day-temp { white-space:nowrap; }
.screen--md .layout.te-quadrant { grid-template-rows:minmax(96px,1fr) 0 auto auto minmax(32px,auto);row-gap:3px; }
.screen--md .te-quadrant .te-current { min-height:96px;grid-template-columns:103px minmax(0,1fr);column-gap:6px; }
.screen--md .te-quadrant .te-current > .te-weather { max-height:90px;object-fit:contain; }
.screen--md .te-quadrant .te-day { align-content:start;padding-top:2px;row-gap:2px; }
.screen--md .te-quadrant .te-day-detail { flex-wrap:wrap;gap:1px 20px; }
.screen--md .te-quadrant .te-precip { flex-wrap:wrap;column-gap:3px;row-gap:0; }
.te-partial .te-condition, .te-partial .te-day-condition,
.te-partial .te-day-detail { white-space:normal;overflow-wrap:break-word; }
.te-partial .te-day-title, .te-partial .te-day-temp { margin:0; }
.screen--lg:not(.screen--portrait) .layout.te-quadrant { grid-template-rows:auto auto auto auto auto;align-content:start;row-gap:4px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-current { min-height:96px;grid-template-columns:112px minmax(0,1fr);grid-template-rows:auto auto;column-gap:8px;align-content:center; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-current > .te-weather { width:104px;height:104px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-forecast { grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:auto;align-content:start;gap:8px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-day { align-content:start;padding:4px 0 0;gap:3px 6px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-day + .te-day { padding-left:8px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-day-detail { display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 8px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-precip { flex-wrap:wrap;gap:2px 4px; }
.screen--lg.screen--portrait .te-quadrant .te-extra-both { display:grid;grid-template-columns:minmax(0,1fr);gap:4px; }
.screen--lg.screen--portrait .te-quadrant .te-extra-both .te-extra-reading { grid-column:1;justify-self:stretch;min-width:0;display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px;white-space:normal; }
.screen--lg.screen--portrait .te-quadrant .te-extra-reading > span { overflow-wrap:break-word; }
.te-quadrant .te-day { position:relative; }
.te-quadrant .te-day-separator { position:absolute; top:0; left:0; }
.te-quadrant .te-day-separator.divider--h { width:100%; }
.te-quadrant .te-day-separator.divider--v { height:100%; }

/* X landscape quarter: primary readings occupy the spare right side of the header. */
.screen--lg:not(.screen--portrait) .layout.te-quadrant { grid-template-columns:repeat(4,minmax(0,1fr)); column-gap:12px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-current { grid-column:1 / 3; grid-row:1; min-height:112px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-metrics { display:contents; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-primary-metric { grid-column:3 / 5; grid-row:1; justify-self:end; width:70%; max-width:100%; flex-direction:column-reverse; align-items:flex-start; justify-content:flex-start; gap:2px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-primary-metric:nth-child(1) { align-self:start; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-primary-metric:nth-child(2) { align-self:end; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-metrics > .te-metric:nth-child(3) { grid-column:1 / 3; grid-row:2; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-metrics > .te-metric:nth-child(4) { grid-column:3 / 5; grid-row:2; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-sun { grid-column:1 / -1; grid-row:3; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:12px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-extra { grid-column:1 / -1; grid-row:4; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-forecast { grid-column:1 / -1; grid-row:5; }
/* Reclaim header space without changing the temperature or icon sizes. */
.screen--lg.screen--portrait .layout.te-quadrant { grid-template-rows:minmax(114px,1fr) auto auto auto auto; }
.screen--lg.screen--portrait .te-quadrant .te-current { margin-top:-10px; margin-bottom:0; }
.screen--lg.screen--portrait .te-quadrant .te-day { padding:3px 0; }
/* Separate the header, supplementary readings and forecast on X landscape. */
.screen--lg:not(.screen--portrait) .te-quadrant .te-metrics > .te-metric:not(.te-primary-metric) { margin-top:12px; }
.screen--lg:not(.screen--portrait) .te-quadrant .te-forecast { margin-top:8px; }
.screen--md .te-quadrant .te-count-space { display:none; }
/* X landscape forecasts: precipitation follows UV on its own line. */
.screen--lg:not(.screen--portrait) .te-quadrant .te-day-detail { flex-direction:column;align-items:flex-start;row-gap:4px; }
</style>
{% if w.temperature == blank %}
<div class="layout layout--col te-partial te-quadrant{{ te_footer_classes }}">
 <strong>Tempest data unavailable</strong>
 <span>Select an active Tempest Weather Station in plugin settings and refresh the source plugin.</span>
</div>
{% else %}
<div class="layout te-partial te-quadrant{{ te_footer_classes }}">
 <div class="te-current">
  <img class="te-weather" src="{{ w.weather_image }}" alt="{{ i18n_conditions }}">
  <span data-temperature-chars="{{ main_temperature | append: '' | size }}" class="te-temp{% if main_temperature >= 100 or main_temperature <= -10 %} te-temp-wide{% endif %} value {% if main_temperature >= 100 or main_temperature <= -10 %}value--base lg:value--base{% elsif main_temperature >= 10 or main_temperature < 0 %}value--large lg:value--large{% else %}value--large lg:value--xlarge{% endif %}">{{ main_temperature }}°</span>
  <span class="te-condition te-condition-fit lg:portrait:hidden label label--small lg:label--base" data-value-fit="true">{{ current_conditions }}</span>
  <span class="te-condition te-condition-wrap hidden lg:portrait:block label label--small lg:label--base">{{ current_conditions }}</span>
 </div>
 <div class="te-metrics grid grid--cols-2">
  <div class="te-metric flex flex--center-y te-primary-metric label label--small lg:label--base"><span>{{ secondary_temperature_label }}</span><strong class="te-number value value--small lg:value--small lg:portrait:value--small">{{ secondary_temperature_value | round }}°</strong></div>
  <div class="te-metric flex flex--center-y te-primary-metric label label--small lg:label--base"><span>{{ i18n_humidity }}</span><strong class="te-number value value--small lg:value--small lg:portrait:value--small">{{ w.humidity }}%</strong></div>
  <div class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-barometer.svg" alt="{{ i18n_pressure }}"><span class="te-number">{{ current_pressure }} {{ pressure_units }}</span>{% if pressure_trend_icon != blank %}<img class="te-icon" src="{{ pressure_trend_icon }}" alt="{{ pressure_trend_alt }}">{% endif %}</div>
  <div class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://tempestwx.com/images/Updated/wind-arrow-{{ w.forecast.right_now.wind.direction_cardinal | downcase }}.svg" alt="{{ i18n_wind_direction }}"><span class="te-number">{{ w.forecast.right_now.wind.gust }} {{ w.forecast.right_now.wind.units }}</span></div>
 </div>
 <div class="te-sun grid grid--cols-2">
  <span class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-sunrise.svg" alt="{{ i18n_sunrise }}">{{ w.forecast.right_now.sunrise }}</span>
  <span class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-sunset.svg" alt="{{ i18n_sunset }}">{{ w.forecast.right_now.sunset }}</span>
 </div>
 {% if information_below_weather_icon == 'both' %}
 {% if solar_available or lightning_available %}
 <div class="te-extra te-extra-both label label--small lg:label--base">
 {% if solar_available %}<span class="te-extra-reading te-solar-reading"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-day-sunny.svg" alt="{{ i18n_solar_radiation }}"><span>{% if solar_radiation != blank %}{{ solar_radiation | round }}{% else %}—{% endif %} W/m² ({% if current_brightness != blank %}{{ current_brightness | round }}{% else %}—{% endif %} lux)</span></span>{% endif %}
 {% if lightning_available %}<span class="te-extra-reading te-lightning-reading"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-lightning.svg" alt="{{ i18n_lightning }}"><span>{{ lightning_last_time }} @ {{ lightning_last_distance }} {{ lightning_distance_units }} ({{ lightning_count_1h }}<span class="te-count-space"> </span>/<span class="te-count-space"> </span>{{ lightning_count_3h }})</span></span>{% endif %}
 </div>
 {% endif %}
 {% else %}
 {% if information_below_weather_icon == 'lightning' and lightning_available %}
 <div class="te-extra label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-lightning.svg" alt="{{ i18n_lightning }}"><span>{{ lightning_last_time }} @ {{ lightning_last_distance }} {{ lightning_distance_units }} ({{ lightning_count_1h }}<span class="te-count-space"> </span>/<span class="te-count-space"> </span>{{ lightning_count_3h }})</span></div>
 {% elsif information_below_weather_icon == 'solar' and solar_available %}
 <div class="te-extra label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-day-sunny.svg" alt="{{ i18n_solar_radiation }}"><span>{% if solar_radiation != blank %}{{ solar_radiation | round }}{% else %}—{% endif %} W/m² ({% if current_brightness != blank %}{{ current_brightness | round }}{% else %}—{% endif %} lux)</span></div>
 {% endif %}
 {% endif %}
 <div class="te-forecast te-forecast-row">
<div class="te-day">
 <strong class="te-day-title title title--small lg:title--base">{{ today_label }}</strong>
 <span class="te-number te-day-temp text--right value value--xxsmall lg:value--small">{{ w.forecast.today.mintemp | round }}° / {{ w.forecast.today.maxtemp | round }}°</span>
 <span class="te-day-condition hidden lg:visible label label--small lg:label--base">{{ today_conditions }}</span>
 <div class="te-day-detail label label--small lg:label--base">
  <span class="te-number">{{ i18n_uv_short }} {{ w.forecast.today.uv_index }}</span>
<span class="te-precip"><span class="te-precip-label">{{ i18n_precipitation }}</span><span class="te-number">{{ w.forecast.today.precip.probability }}%</span>{% if w.forecast.today.precip.amount != blank %}<span class="te-number te-amount">{{ w.forecast.today.precip.amount | round: 1 }} {{ w.forecast.today.precip.units }}</span>{% endif %}</span>
 </div>
</div>
<div class="te-day">
<div class="divider--h te-day-separator hidden lg:portrait:visible" aria-hidden="true"></div>
<div class="divider--v te-day-separator lg:portrait:hidden" aria-hidden="true"></div>
 <strong class="te-day-title title title--small lg:title--base">{{ tomorrow_label }}</strong>
 <span class="te-number te-day-temp text--right value value--xxsmall lg:value--small">{{ w.forecast.tomorrow.mintemp | round }}° / {{ w.forecast.tomorrow.maxtemp | round }}°</span>
 <span class="te-day-condition hidden lg:visible label label--small lg:label--base">{{ tomorrow_conditions }}</span>
 <div class="te-day-detail label label--small lg:label--base">
  <span class="te-number">{{ i18n_uv_short }} {{ w.forecast.tomorrow.uv_index }}</span>
<span class="te-precip"><span class="te-precip-label">{{ i18n_precipitation }}</span><span class="te-number">{{ w.forecast.tomorrow.precip.probability }}%</span>{% if w.forecast.tomorrow.precip.amount != blank %}<span class="te-number te-amount">{{ w.forecast.tomorrow.precip.amount | round: 1 }} {{ w.forecast.tomorrow.precip.units }}</span>{% endif %}</span>
 </div>
</div>
 </div>
</div>
{% endif %}
{% unless hide_footer %}
<div class="title_bar te-title{{ te_footer_classes }}">
 <span class="image">t°</span><span class="title">{{ i18n_weather }}</span>
 <span class="instance">{{ trmnl.plugin_settings.instance_name }}{% if footer_refreshed_at != blank %} ({{ footer_refreshed_at }}){% endif %}</span>
</div>
{% endunless %}
