{%- assign te_footer_classes = '' -%}
{%- assign te_footer_policy = trmnl.plugin_settings.custom_fields_values.footer_visibility_og | default: 'show' -%}
{%- if te_footer_policy == 'hide_all' or te_footer_policy == 'hide_half_vertical' or te_footer_policy == 'hide_partial' -%}
{%- assign te_footer_classes = te_footer_classes | append: ' te-footer-hide-og' -%}
{%- endif -%}
{%- assign te_footer_policy = trmnl.plugin_settings.custom_fields_values.footer_visibility_x | default: 'show' -%}
{%- if te_footer_policy == 'hide_all' or te_footer_policy == 'hide_half_vertical' or te_footer_policy == 'hide_partial' -%}
{%- assign te_footer_classes = te_footer_classes | append: ' te-footer-hide-x' -%}
{%- endif -%}

{%- assign hide_footer = false -%}
{%- if te_device_family == 'og' and te_footer_classes contains 'te-footer-hide-og' -%}
  {%- assign hide_footer = true -%}
{%- elsif te_device_family == 'x' and te_footer_classes contains 'te-footer-hide-x' -%}
  {%- assign hide_footer = true -%}
{%- endif -%}

<style>
/* Scoped geometry supplements native responsive utilities. */
.te-partial .te-forecast-row { grid-row:5; }
.layout.te-partial:where(.te-vertical) { display:grid;width:100%;min-width:0;align-items:stretch;align-content:stretch;justify-content:stretch;grid-template-columns:minmax(0,1fr);grid-template-rows:1.3fr auto auto auto 1.2fr;gap:8px; }
.te-partial:where(.te-vertical) * { box-sizing:border-box;min-width:0; }
.te-partial:where(.te-vertical) .te-current { display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;column-gap:14px; }
.te-partial:where(.te-vertical) .te-weather { width:100px;height:100px;object-fit:contain;grid-row:1 / 3;filter:brightness(.5) grayscale(1); }
.te-partial:where(.te-vertical) .te-temp { white-space:nowrap;align-self:end; }
.te-partial:where(.te-vertical) .te-condition { align-self:start;overflow-wrap:anywhere; }
.te-partial:where(.te-vertical) .te-metrics { gap:8px 12px;align-content:center; }
.te-partial:where(.te-vertical) .te-metric {gap:5px; }
.te-partial:where(.te-vertical) .te-primary-metric { flex-direction:column-reverse;align-items:flex-start;gap:3px; }
.te-partial:where(.te-vertical) .te-icon { width:22px;height:22px;object-fit:contain;flex-shrink:0; }
.te-partial:where(.te-vertical) .te-number { white-space:nowrap; }
.te-partial:where(.te-vertical) .te-sun { gap:12px; }
.te-partial:where(.te-vertical) .te-extra { display:flex;align-items:center;gap:5px; }
.te-partial:where(.te-vertical) .te-forecast { display:grid;grid-template-rows:1fr 1fr;border-top:1px solid;min-width:0; }
.te-partial:where(.te-vertical) .te-day { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:6px 10px;padding:10px 0;align-content:center; }


.te-partial:where(.te-vertical) .te-day-condition { grid-column:1 / -1;overflow-wrap:anywhere; }
.te-partial:where(.te-vertical) .te-day-detail { grid-column:1 / -1;display:grid;gap:6px;align-items:start; }
.te-partial:where(.te-vertical) .te-precip { display:flex;flex-direction:column;gap:3px; }
.te-vertical .te-weather { width:196.0px;height:196.0px; }
.te-title .title { flex-shrink:0; }
.te-title .instance { min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.te-partial:where(.te-vertical) .te-amount { text-align:left; }
.te-partial:where(.te-vertical) .te-day-detail { grid-template-columns:.65fr 1fr; }
.te-partial:where(.te-vertical) .te-forecast-icon { object-fit:contain;filter:brightness(.5) grayscale(1); }
.layout.te-vertical { grid-template-rows:auto auto auto auto minmax(0,1fr);gap:12px; }
.te-vertical .te-current { padding:8px 0; }
.te-vertical .te-metrics { border-top:1px solid #aaa;padding-top:12px;gap:12px; }
.te-vertical .te-day { grid-template-columns:minmax(0,1fr) minmax(100px,.65fr); }
.te-vertical .te-day-condition { grid-column:1;grid-row:2; }
.te-vertical .te-day-detail { grid-column:1;grid-row:3; }
.te-vertical .te-forecast-icon { grid-column:2;grid-row:2 / 4;justify-self:end;align-self:center;width:100px;height:100px; }
.screen--md .te-vertical .te-weather { width:160px;height:160px; }
.screen--md .layout.te-vertical { gap:4px; }
.screen--md .te-vertical .te-current { position:relative;grid-template-columns:160px minmax(0,1fr);grid-template-rows:auto auto;min-height:117px;padding:0;align-content:center; }
.screen--md .te-vertical .te-current > .te-weather { position:absolute;left:0;top:50%;transform:translateY(-50%); }
.screen--md .te-vertical .te-temp { grid-column:2;grid-row:1; }
.screen--md .te-vertical .te-condition { grid-column:2;grid-row:2; }
.screen--md .te-vertical .te-metrics { padding-top:4px; row-gap:4px; }
.screen--md .te-vertical .te-forecast-icon { display:none; }
.screen--md .te-vertical .te-day { grid-template-columns:minmax(0,1fr) auto;padding:4px 0;gap:3px 10px; }
.screen--md .te-vertical .te-day-condition { grid-column:1 / -1; }
.screen--md .te-vertical .te-day-detail { grid-column:1 / -1; }
.screen--md .te-vertical .te-day-detail { display:flex;align-items:baseline;gap:6px 18px; }
.screen--md .te-vertical .te-precip { flex-direction:row;align-items:baseline;gap:6px;white-space:nowrap; }
.screen--lg .te-vertical .te-current { position:relative;padding:0;min-height:0;grid-template-columns:196px minmax(0,1fr);grid-template-rows:auto auto;align-content:center; }
.screen--lg .te-vertical .te-current > .te-weather { position:absolute;left:0;top:50%;transform:translateY(-50%); }
.screen--lg .te-vertical .te-temp { grid-column:2;grid-row:1; }
.screen--lg .te-vertical .te-condition { grid-column:2;grid-row:2; }
.te-partial .te-extra-both { display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 10px; }
.te-partial .te-extra-reading { display:inline-flex;align-items:center;gap:4px;white-space:nowrap; }
.screen--lg .te-vertical .te-extra-both { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:12px; }
.screen--lg .te-vertical .te-lightning-reading { grid-column:2; }
.screen--md .te-vertical .te-extra-both { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:12px;align-items:center; }
.screen--md .te-vertical .te-extra-both .te-solar-reading { grid-column:1;grid-row:1; }
.screen--md .te-vertical .te-extra-both .te-lightning-reading { grid-column:2;grid-row:1; }
.screen--lg.screen--portrait .te-vertical .te-weather { width:133.28px;height:133.28px; }
.screen--lg.screen--portrait .te-vertical .te-current { grid-template-columns:156.8px minmax(0,1fr);column-gap:8px; }
.screen--lg.screen--portrait .te-vertical .te-extra-both { display:flex;flex-direction:column;align-items:flex-start;gap:8px; }
.screen--md .te-vertical .te-current > .te-weather { width:123.12px;height:123.12px; }
.screen--lg:not(.screen--portrait) .te-vertical .te-current > .te-weather { width:166.6px;height:166.6px; }
.screen--lg .te-vertical .te-condition { white-space:normal;overflow-wrap:break-word;max-width:100%; }
.screen--lg .te-vertical .te-day-temp { white-space:nowrap; }
.te-partial .te-condition, .te-partial .te-day-condition,
.te-partial .te-day-detail { white-space:normal;overflow-wrap:break-word; }
.te-partial .te-day-title, .te-partial .te-day-temp { margin:0; }
.screen--lg.screen--portrait .te-vertical .te-forecast { grid-template-rows:auto auto;align-content:start; }
.screen--lg.screen--portrait .te-vertical .te-day { align-content:start;padding:18px 0;row-gap:10px; }
.te-vertical .te-day { position:relative; }
.te-vertical .te-day-separator { position:absolute; top:0; left:0; }
.te-vertical .te-day-separator.divider--h { width:100%; }
.te-vertical .te-day-separator.divider--v { height:100%; }

/* OG: avoid fractional forecast rows distributing unused height between days. */
.screen--md .te-vertical .te-forecast { grid-template-rows:auto auto; align-content:start; }
.screen--md .te-vertical .te-day { align-content:start; }
</style>
{% if w.temperature == blank %}
<div class="layout layout--col te-partial te-vertical{{ te_footer_classes }}">
 <strong>Tempest data unavailable</strong>
 <span>Select an active Tempest Weather Station in plugin settings and refresh the source plugin.</span>
</div>
{% else %}
<div class="layout te-partial te-vertical{{ te_footer_classes }}">
 <div class="te-current">
  <img class="te-weather" src="{{ w.weather_image }}" alt="{{ i18n_conditions }}">
  <span data-temperature-chars="{{ main_temperature | append: '' | size }}" class="te-temp value {% if main_temperature >= 100 or main_temperature <= -10 %}value--large lg:value--xlarge{% elsif main_temperature >= 10 or main_temperature < 0 %}value--xlarge lg:value--xxlarge{% else %}value--xxlarge lg:value--xxxlarge{% endif %}">{{ main_temperature }}°</span>
  <span class="te-condition label label--small lg:label--base" data-value-fit="true">{{ current_conditions }}</span>
 </div>
 <div class="te-metrics grid grid--cols-2">
  <div class="te-metric flex flex--center-y te-primary-metric label label--small lg:label--base"><span>{{ secondary_temperature_label }}</span><strong class="te-number value value--small lg:value--large">{{ secondary_temperature_value | round }}°</strong></div>
  <div class="te-metric flex flex--center-y te-primary-metric label label--small lg:label--base"><span>{{ i18n_humidity }}</span><strong class="te-number value value--small lg:value--large">{{ w.humidity }}%</strong></div>
  <div class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-barometer.svg" alt="{{ i18n_pressure }}"><span class="te-number">{{ current_pressure }} {{ pressure_units }}</span>{% if pressure_trend_icon != blank %}<img class="te-icon" src="{{ pressure_trend_icon }}" alt="{{ pressure_trend_alt }}">{% endif %}</div>
  <div class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://tempestwx.com/images/Updated/wind-arrow-{{ w.forecast.right_now.wind.direction_cardinal | downcase }}.svg" alt="{{ i18n_wind_direction }}"><span class="te-number">{{ w.forecast.right_now.wind.gust }} {{ w.forecast.right_now.wind.units }}</span></div>
 </div>
 <div class="te-sun grid grid--cols-2">
  <span class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-sunrise.svg" alt="{{ i18n_sunrise }}">{{ w.forecast.right_now.sunrise }}</span>
  <span class="te-metric flex flex--center-y label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-sunset.svg" alt="{{ i18n_sunset }}">{{ w.forecast.right_now.sunset }}</span>
 </div>
 {% if information_below_weather_icon == 'both' %}
 {% if solar_available or lightning_available %}
 <div class="te-extra te-extra-both label label--small lg:label--base">
 {% if solar_available %}<span class="te-extra-reading te-solar-reading"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-day-sunny.svg" alt="{{ i18n_solar_radiation }}"><span>{% if solar_radiation != blank %}{{ solar_radiation | round }}{% else %}—{% endif %} W/m² ({% if current_brightness != blank %}{{ current_brightness | round }}{% else %}—{% endif %} lux)</span></span>{% endif %}
 {% if lightning_available %}<span class="te-extra-reading te-lightning-reading"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-lightning.svg" alt="{{ i18n_lightning }}"><span>{{ lightning_last_time }} @ {{ lightning_last_distance }} {{ lightning_distance_units }} ({{ lightning_count_1h }} / {{ lightning_count_3h }})</span></span>{% endif %}
 </div>
 {% endif %}
 {% else %}
 {% if information_below_weather_icon == 'lightning' and lightning_available %}
 <div class="te-extra label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-lightning.svg" alt="{{ i18n_lightning }}"><span>{{ lightning_last_time }} @ {{ lightning_last_distance }} {{ lightning_distance_units }} ({{ lightning_count_1h }} / {{ lightning_count_3h }})</span></div>
 {% elsif information_below_weather_icon == 'solar' and solar_available %}
 <div class="te-extra label label--small lg:label--base"><img class="te-icon" src="https://trmnl.com/images/plugins/weather/wi-day-sunny.svg" alt="{{ i18n_solar_radiation }}"><span>{% if solar_radiation != blank %}{{ solar_radiation | round }}{% else %}—{% endif %} W/m² ({% if current_brightness != blank %}{{ current_brightness | round }}{% else %}—{% endif %} lux)</span></div>
 {% endif %}
 {% endif %}
 <div class="te-forecast te-forecast-row">
<div class="te-day">
 <strong class="te-day-title title title--small lg:title--base lg:portrait:title--large">{{ today_label }}</strong>
 <span class="te-number te-day-temp text--right value value--xxsmall lg:value--small">{{ w.forecast.today.mintemp | round }}° / {{ w.forecast.today.maxtemp | round }}°</span>
 <span class="te-day-condition label label--small lg:label--base lg:portrait:label--large">{{ today_conditions }}</span>
 {% if w.today_weather_image != blank %}<img class="te-forecast-icon" src="{{ w.today_weather_image }}" alt="{{ today_conditions }}">{% endif %}
 <div class="te-day-detail label label--small lg:label--base lg:portrait:label--large">
  <span class="te-number">{{ i18n_uv_short }} {{ w.forecast.today.uv_index }}</span>
<span class="te-precip"><span class="te-precip-label">{{ i18n_precipitation }}</span><span class="te-number">{{ w.forecast.today.precip.probability }}%</span>{% if w.forecast.today.precip.amount != blank %}<span class="te-number te-amount">{{ w.forecast.today.precip.amount | round: 1 }} {{ w.forecast.today.precip.units }}</span>{% endif %}</span>
 </div>
</div>
<div class="te-day">
<div class="divider--h te-day-separator" aria-hidden="true"></div>
 <strong class="te-day-title title title--small lg:title--base lg:portrait:title--large">{{ tomorrow_label }}</strong>
 <span class="te-number te-day-temp text--right value value--xxsmall lg:value--small">{{ w.forecast.tomorrow.mintemp | round }}° / {{ w.forecast.tomorrow.maxtemp | round }}°</span>
 <span class="te-day-condition label label--small lg:label--base lg:portrait:label--large">{{ tomorrow_conditions }}</span>
 {% if w.tomorrow_weather_image != blank %}<img class="te-forecast-icon" src="{{ w.tomorrow_weather_image }}" alt="{{ tomorrow_conditions }}">{% endif %}
 <div class="te-day-detail label label--small lg:label--base lg:portrait:label--large">
  <span class="te-number">{{ i18n_uv_short }} {{ w.forecast.tomorrow.uv_index }}</span>
<span class="te-precip"><span class="te-precip-label">{{ i18n_precipitation }}</span><span class="te-number">{{ w.forecast.tomorrow.precip.probability }}%</span>{% if w.forecast.tomorrow.precip.amount != blank %}<span class="te-number te-amount">{{ w.forecast.tomorrow.precip.amount | round: 1 }} {{ w.forecast.tomorrow.precip.units }}</span>{% endif %}</span>
 </div>
</div>
 </div>
</div>
{% endif %}
{% unless hide_footer %}
<div class="title_bar te-title{{ te_footer_classes }}">
 <span class="image">t°</span><span class="title">{{ i18n_weather }}</span>
 <span class="instance">{{ trmnl.plugin_settings.instance_name }}{% if footer_refreshed_at != blank %} ({{ footer_refreshed_at }}){% endif %}</span>
</div>
{% endunless %}
